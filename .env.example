# Copy this file to .env.local and fill in the keys you have. Never commit .env.local
# (it's gitignored) or paste real values into chat, issues, or logs.

# Jev needs one of these two. TYPESAFE_API_KEY, if set, always takes precedence.
# TYPESAFE_API_KEY=ts-...
OPENROUTER_API_KEY=sk-or-v1-...

# Only needed by examples/planner.py, to turn one natural-language request into an
# ordered multi-window plan before handing each step to Jev.
DEEPSEEK_API_KEY=sk-...
